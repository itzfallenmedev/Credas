<!DOCTYPE html>
<html lang="en">
<head>
<%- include('partials/credas-head', { pageTitle: settings.productsPageTitle, pageDesc: settings.productsPageSubtitle }) %>
</head>
<body>
<%- include('partials/navbar', { user, existingUser, currentPath: '/products' }) %>

<main id="main">
<section class="page-head">
  <div class="wrap">
    <p class="crumb"><a href="/">Home</a><span>/</span>Products</p>
    <h1 class="t-h1"><%= settings.productsPageTitle %></h1>
    <p class="t-lead" style="margin-top:var(--sp-3)"><%= settings.productsPageSubtitle %></p>
  </div>
</section>

<section class="section" style="padding-top:var(--sp-5)">
  <div class="wrap">

    <% if (settings.productCategories && settings.productCategories.length) { %>
      <div class="chips" style="margin-bottom:var(--sp-4)">
        <a class="chip" href="/products" aria-current="true">All products</a>
        <% settings.productCategories.forEach(function (c) { %>
          <a class="chip" href="/products/category/<%= c.url %>"><%= c.name %></a>
        <% }); %>
      </div>
    <% } %>

    <form class="toolbar" style="margin-bottom:var(--sp-5)" role="search" onsubmit="return false">
      <div class="field grow">
        <label for="q">Search</label>
        <input class="input" id="q" type="search" data-search placeholder="Product name or category" autocomplete="off">
      </div>
      <div class="field">
        <label for="sort">Sort</label>
        <select class="select" id="sort" data-sort>
          <option value="featured">Shelf order</option>
          <option value="new">Newest first</option>
          <option value="price-asc">Price: low to high</option>
          <option value="price-desc">Price: high to low</option>
          <option value="name">Name: A to Z</option>
        </select>
      </div>
      <div class="field">
        <span class="t-label" id="vl">Layout</span>
        <div class="view-toggle" role="group" aria-labelledby="vl">
          <button type="button" data-view="default" aria-pressed="true" aria-label="Three per row"><i data-lucide="columns-3"></i></button>
          <button type="button" data-view="compact" aria-pressed="false" aria-label="Four per row"><i data-lucide="columns-4"></i></button>
        </div>
      </div>
    </form>

    <p class="t-sm" style="margin-bottom:var(--sp-4)"><span data-count><%= products ? products.length : 0 %></span> product<%= products && products.length === 1 ? '' : 's' %></p>

    <% if (!products || !products.length) { %>
      <div class="state">
        <i data-lucide="package-open"></i>
        <h2>No products listed</h2>
        <p>Nothing has been added to the shelf yet. Ask in the Discord when the next batch goes live.</p>
        <a class="btn btn-primary" href="<%= settings.discordInviteLink %>">Join the Discord</a>
      </div>
    <% } else { %>
      <div class="plates <%= settings.productGridDensity === 'cozy' ? 'dense' : '' %>" data-grid>
        <% products.forEach(function (p) { %>
        <% var now = new Date(); %>
        <% var sale = p.onSale && p.saleStartDate && p.saleEndDate && new Date(p.saleStartDate) <= now && now <= new Date(p.saleEndDate); %>
        <% var eff = sale ? p.salePrice : p.price; %>
        <% var off = sale && p.price ? Math.round(((p.price - p.salePrice) / p.price) * 100) : 0; %>
        <% var oos = p.productType === 'serials' && (!p.serials || !p.serials.length); %>
        <% var low = p.productType === 'serials' && p.serials && p.serials.length > 0 && p.serials.length <= 5; %>
        <% var desc = String(p.description || '').replace(/[#*`>\[\]()!]/g, '').slice(0, 96); %>
        <article class="plate-card"
          data-name="<%= p.name.toLowerCase() %>" data-cat="<%= (p.category || '').toLowerCase() %>"
          data-price="<%= eff %>" data-pos="<%= p.position || 0 %>"
          data-created="<%= p.createdAt ? new Date(p.createdAt).toISOString() : '' %>"
          data-qv='<%- JSON.stringify({ img: "/" + p.bannerImage, cat: p.category || "", name: p.name, desc: desc, url: "/products/" + p.urlId, priceHtml: (p.productType === "digitalFree" ? "Free" : settings.currencySymbol + Number(eff).toFixed(2)) }).replace(/'/g, "&#39;") %>'>

          <div class="plate-media">
            <a href="/products/<%= p.urlId %>" tabindex="-1" aria-hidden="true"><img src="/<%= p.bannerImage %>" alt="" loading="lazy"></a>
            <div class="plate-flags">
              <% if (sale) { %><span class="flag flag-sale">−<%= off %>%</span><% } %>
              <% if (p.productType === 'digitalFree') { %><span class="flag flag-free">Free</span><% } %>
              <% if (p.pauseSelling) { %><span class="flag">Paused</span><% } %>
            </div>
            <% if (settings.wishlistEnabled) { %>
              <button class="save-btn" type="button" data-save="<%= p._id %>" aria-pressed="false" aria-label="Save <%= p.name %>"><i data-lucide="heart"></i></button>
            <% } %>
          </div>

          <div class="plate-body">
            <% if (p.category) { %><span class="plate-cat"><%= p.category %></span><% } %>
            <h3><a href="/products/<%= p.urlId %>"><%= p.name %></a></h3>
            <p class="plate-desc"><%= desc %></p>
            <% if (oos) { %><span class="stock-line out"><span class="dot"></span>Out of stock</span>
            <% } else if (low) { %><span class="stock-line low"><span class="dot"></span>Only <%= p.serials.length %> left</span><% } %>
            <% if (sale) { %><span class="countdown" data-countdown="<%= new Date(p.saleEndDate).toISOString() %>"></span><% } %>
          </div>

          <div class="plate-buy">
            <span class="price <%= sale ? 'is-sale' : '' %>">
              <% if (p.productType === 'digitalFree') { %>Free<% } else { %><%= settings.currencySymbol %><%= Number(eff).toFixed(2) %><% if (sale) { %><s><%= settings.currencySymbol %><%= p.price.toFixed(2) %></s><% } %><% } %>
            </span>
            <span class="spacer"></span>
            <button class="btn btn-quiet btn-sm" type="button" data-dialog-open="qv">Details</button>
            <% if (!p.pauseSelling && !oos && p.productType !== 'digitalFree') { %>
              <form action="/cart/add/<%= p._id %>" method="POST">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <button class="btn btn-primary btn-sm" type="submit">Add to cart</button>
              </form>
            <% } else { %>
              <a class="btn btn-ghost btn-sm" href="/products/<%= p.urlId %>"><%= oos ? 'View' : 'Open' %></a>
            <% } %>
          </div>
        </article>
        <% }); %>
      </div>

      <div class="state" data-empty hidden>
        <i data-lucide="search"></i>
        <h2>Nothing matches “<span data-term></span>”</h2>
        <p>Try a shorter search term, or clear the search to see the whole shelf.</p>
      </div>
    <% } %>

    <div data-recent-wrap style="margin-top:var(--sp-8)">
      <h2 class="t-h3" style="margin-bottom:var(--sp-4)">Recently viewed</h2>
      <div class="plates dense" data-recent></div>
    </div>
  </div>
</section>
</main>

<div class="dialog-wrap" id="qv" data-open="false">
  <div class="dialog" role="dialog" aria-modal="true" aria-labelledby="qv-t">
    <div class="dialog-head">
      <h2 id="qv-t" data-qv-name></h2>
      <button class="dialog-x" type="button" data-dialog-close aria-label="Close"><i data-lucide="x"></i></button>
    </div>
    <div class="dialog-body">
      <img data-qv-img src="" alt="">
      <div style="display:flex;align-items:center;justify-content:space-between;gap:var(--sp-4);margin-top:var(--sp-4);flex-wrap:wrap">
        <span class="plate-cat" data-qv-cat></span>
        <span class="price" data-qv-price style="font-size:1.25rem"></span>
      </div>
      <p class="t-body" data-qv-desc style="margin-top:var(--sp-3)"></p>
      <a class="btn btn-primary btn-block" data-qv-link href="#" style="margin-top:var(--sp-5)">Open product page</a>
    </div>
  </div>
</div>

<%- include('partials/footer') %>
</body>
</html>
