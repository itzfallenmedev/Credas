<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Staff Panel | Tickets</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/bulma/0.9.4/css/bulma.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
    <link rel="icon" href="<%= settings.faviconPath %>" type="image/x-icon">
    <style>
        :root {
            --accent-color: <%= settings.accentColor %>;
            --accent-color-rgb: <%= accentColorRgb %>;
            --text-color: #c9d1d9;
            --title-color: #ffffff;
            --subtitle-color: #8b949e;
        }

        .staff-panel {
            display: flex;
            flex-direction: column;
            min-height: 100vh;
        }

        .content {
            flex-grow: 1;
            padding: 20px;
        }

        h1.title {
            color: var(--title-color) !important;
        }

        .subtitle {
            color: var(--subtitle-color);
        }

        .tabs.is-toggle a {
            color: var(--text-color);
            border-color: #30363d;
        }

        .tabs.is-toggle li.is-active a {
            color: var(--accent-color);
            border-color: var(--accent-color);
            background: rgba(var(--accent-color-rgb), 0.08);
        }

        .tabs.is-toggle a:hover {
            color: var(--accent-color);
            border-color: var(--accent-color);
        }
    </style>
</head>
<body>
    <%- include('../partials/navbar', { user, existingUser }) %>

    <div class="staff-panel">
        <%- include('../partials/staff-navbar', { user, currentPage: 'tickets' }) %>

        <div class="content">
            <section class="section">
                <h1 class="title">Ticket queue</h1>
                <p class="subtitle">Oldest activity first. Reply from the ticket page and the buyer is marked as awaiting response.</p>

                <ul class="tabs is-toggle is-fullwidth">
                    <li class="<%= !status ? 'is-active' : '' %>">
                        <a href="/staff/tickets">All</a>
                    </li>
                    <% ['open','awaiting-staff','awaiting-customer','resolved','closed'].forEach(function (s) { %>
                        <li class="<%= status === s ? 'is-active' : '' %>">
                            <a href="/staff/tickets?status=<%= s %>"><%= s %></a>
                        </li>
                    <% }); %>
                </ul>

                <% if (!tickets.length) { %>
                    <div class="notification is-warning has-text-centered">No tickets match this filter.</div>
                <% } else { %>
                    <table class="table is-fullwidth is-striped is-hoverable">
                        <thead>
                            <tr>
                                <th>Reference</th>
                                <th>Subject</th>
                                <th>Customer</th>
                                <th>Priority</th>
                                <th>Status</th>
                                <th>Replies</th>
                                <th>Last activity</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% tickets.forEach(function (t) { %>
                                <tr>
                                    <td><a href="/tickets/<%= t._id %>"><strong><%= t.reference %></strong></a></td>
                                    <td>
                                        <%= t.subject %>
                                        <% if (t.productName) { %><br><span class="is-size-7 has-text-grey"><%= t.productName %></span><% } %>
                                    </td>
                                    <td><%= t.username || t.userID %></td>
                                    <td>
                                        <% if (t.priority === 'urgent' || t.priority === 'high') { %><span class="tag is-warning is-light"><%= t.priority %></span>
                                        <% } else { %><span class="tag is-light"><%= t.priority %></span><% } %>
                                    </td>
                                    <td>
                                        <% if (t.status === 'resolved' || t.status === 'closed') { %><span class="tag is-success is-light"><%= t.status %></span>
                                        <% } else { %><span class="tag is-info is-light"><%= t.status %></span><% } %>
                                    </td>
                                    <td><%= (t.messages || []).length %></td>
                                    <td><%= new Date(t.lastReplyAt).toLocaleString('en-US', { month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit' }) %></td>
                                </tr>
                            <% }); %>
                        </tbody>
                    </table>
                <% } %>
            </section>
        </div>
    </div>

    <%- include('../partials/footer') %>
</body>

</html>
