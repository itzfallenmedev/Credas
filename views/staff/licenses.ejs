<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Staff Panel | Licenses</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/bulma/0.9.4/css/bulma.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
    <link rel="icon" href="<%= settings.faviconPath %>" type="image/x-icon">
    <style>
        :root {
            --accent-color: <%= settings.accentColor %>;
            --text-color: #c9d1d9;
            --title-color: #ffffff;
            --subtitle-color: #8b949e;
            --card-bg-color: #161b22;
        }

        .staff-panel {
            display: flex;
            flex-direction: column;
            min-height: 100vh;
        }

        .content {
            flex-grow: 1;
            padding: 20px;
        }

        h1.title {
            color: var(--title-color) !important;
        }

        .subtitle {
            color: var(--subtitle-color);
        }

        .staff-actions {
            display: flex;
            flex-wrap: wrap;
            gap: 6px;
        }

        .action-button {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 32px;
            height: 32px;
            background: transparent;
            border: 1px solid var(--subtitle-color);
            color: var(--text-color);
            border-radius: 6px;
            cursor: pointer;
        }

        .action-button:hover {
            border-color: var(--accent-color);
            color: var(--accent-color);
        }

        .action-edit:hover {
            border-color: #ffa726;
            color: #ffa726;
        }

        .action-delete:hover {
            border-color: #e53935;
            color: #e53935;
        }

        .keybox {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
            background: #0d1117;
            border: 1px dashed var(--accent-color);
            border-radius: 6px;
            padding: 12px 16px;
            font-family: 'JetBrains Mono', monospace;
            font-size: 0.8rem;
            color: var(--title-color);
            word-break: break-all;
        }

        .keybox button {
            background: transparent;
            border: 0;
            color: var(--accent-color);
            cursor: pointer;
            font-size: 1rem;
        }

        .mono {
            font-family: 'JetBrains Mono', monospace;
            font-size: 0.78rem;
        }

        .empty-hint {
            color: var(--subtitle-color);
            font-size: 0.9rem;
        }
    </style>
</head>
<body>
    <%- include('../partials/navbar', { user, existingUser }) %>

    <div class="staff-panel">
        <%- include('../partials/staff-navbar', { user, currentPage: 'licenses' }) %>

        <div class="content">
            <section class="section">
                <h1 class="title">Licenses</h1>
                <p class="subtitle">Issue keys, manage hardware locks, expiry and revocation.</p>

                <% if (typeof issued !== 'undefined' && issued) { %>
                    <div class="card">
                        <div class="card-content">
                            <p class="title is-5">Key issued</p>
                            <p class="subtitle is-6">Copy it now &mdash; it is stored encrypted and cannot be recovered in plain text after you leave this page.</p>
                            <div class="keybox">
                                <span id="newkey"><%= issued %></span>
                                <button type="button" onclick="navigator.clipboard.writeText('<%= issued %>')" aria-label="Copy key">
                                    <i class="fas fa-copy"></i>
                                </button>
                            </div>
                        </div>
                    </div>
                <% } %>

                <div class="card">
                    <header class="card-header">
                        <p class="card-header-title">Issue a license</p>
                    </header>
                    <div class="card-content">
                        <form action="/staff/licenses/create" method="POST">
                            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                            <div class="columns">
                                <div class="column">
                                    <div class="field">
                                        <label class="label" for="p">Product</label>
                                        <div class="control">
                                            <div class="select is-fullwidth">
                                                <select id="p" name="product" required>
                                                    <option value="">Choose...</option>
                                                    <% (typeof products !== 'undefined' ? products : []).forEach(function (p) { %><option value="<%= p._id %>"><%= p.name %></option><% }); %>
                                                </select>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div class="column">
                                    <div class="field">
                                        <label class="label" for="u">Discord user ID (optional)</label>
                                        <div class="control">
                                            <input class="input" id="u" name="ownerID" placeholder="123456789">
                                        </div>
                                    </div>
                                </div>
                                <div class="column">
                                    <div class="field">
                                        <label class="label" for="un">Username (optional)</label>
                                        <div class="control">
                                            <input class="input" id="un" name="ownerUsername" placeholder="customer">
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="columns">
                                <div class="column">
                                    <div class="field">
                                        <label class="label" for="h">Device limit (0 = unlimited)</label>
                                        <div class="control">
                                            <input class="input" id="h" name="maxHwid" type="number" min="0" value="1">
                                        </div>
                                    </div>
                                </div>
                                <div class="column">
                                    <div class="field">
                                        <label class="label" for="d">Valid for (days, 0 = never)</label>
                                        <div class="control">
                                            <input class="input" id="d" name="days" type="number" min="0" value="0">
                                        </div>
                                    </div>
                                </div>
                                <div class="column">
                                    <div class="field">
                                        <label class="label" for="s">Session limit (0 = unlimited)</label>
                                        <div class="control">
                                            <input class="input" id="s" name="sessionLimit" type="number" min="0" value="0">
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="field">
                                <label class="label" for="n">Internal note</label>
                                <div class="control">
                                    <input class="input" id="n" name="notes" maxlength="500" placeholder="Only staff see this">
                                </div>
                            </div>
                            <div class="field">
                                <div class="control">
                                    <button class="button is-info" type="submit">
                                        <span class="icon is-small"><i class="fas fa-key"></i></span>
                                        <span>Issue key</span>
                                    </button>
                                </div>
                            </div>
                        </form>
                    </div>
                </div>

                <form method="GET" action="/staff/licenses">
                    <div class="columns is-vcentered">
                        <div class="column is-half">
                            <div class="field">
                                <label class="label" for="q">Search</label>
                                <div class="control">
                                    <input class="input" id="q" name="q" value="<%= q || '' %>" placeholder="Key, username or product">
                                </div>
                            </div>
                        </div>
                        <div class="column is-one-quarter">
                            <div class="field">
                                <label class="label" for="st">Status</label>
                                <div class="control">
                                    <div class="select is-fullwidth">
                                        <select id="st" name="status">
                                            <option value="">All</option>
                                            <% ['active','suspended','banned','expired'].forEach(function (s) { %><option value="<%= s %>" <%= status === s ? 'selected' : '' %>><%= s %></option><% }); %>
                                        </select>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="column">
                            <div class="field">
                                <div class="control">
                                    <button class="button is-info is-light" type="submit">
                                        <span class="icon is-small"><i class="fas fa-filter"></i></span>
                                        <span>Filter</span>
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                </form>

                <% if (licenses.length === 0) { %>
                    <div class="notification is-warning has-text-centered">No licenses found.</div>
                <% } else { %>
                    <table class="table is-fullwidth is-striped is-hoverable">
                        <thead>
                            <tr>
                                <th>Key</th>
                                <th>Product</th>
                                <th>Owner</th>
                                <th>Status</th>
                                <th>HWID</th>
                                <th>Expires</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% licenses.forEach(function (l) { %>
                                <% var expired = l.expiresAt && new Date(l.expiresAt) <= new Date(); var st = expired ? 'expired' : l.status; %>
                                <tr>
                                    <td><span class="mono"><%= l.plainKey || '—' %></span></td>
                                    <td><%= l.productName %></td>
                                    <td><%= l.ownerUsername || l.ownerID || 'unassigned' %></td>
                                    <td>
                                        <% if (st === 'active') { %><span class="tag is-success is-light"><%= st %></span>
                                        <% } else if (st === 'expired') { %><span class="tag is-warning is-light"><%= st %></span>
                                        <% } else { %><span class="tag is-danger is-light"><%= st %></span><% } %>
                                    </td>
                                    <td><%= l.hwid ? 'bound' : (l.maxHwid === 0 ? 'n/a' : 'free') %></td>
                                    <td><%= l.expiresAt ? new Date(l.expiresAt).toLocaleDateString('en-US') : 'never' %></td>
                                    <td>
                                        <div class="staff-actions">
                                            <% if (l.status === 'active') { %>
                                                <form action="/staff/licenses/<%= l._id %>/suspend" method="POST" style="display:inline;">
                                                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                                    <button type="submit" title="Suspend" class="action-button">
                                                        <i class="fas fa-pause"></i>
                                                    </button>
                                                </form>
                                            <% } else { %>
                                                <form action="/staff/licenses/<%= l._id %>/unban" method="POST" style="display:inline;">
                                                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                                    <button type="submit" title="Unban" class="action-button">
                                                        <i class="fas fa-play"></i>
                                                    </button>
                                                </form>
                                            <% } %>
                                            <form action="/staff/licenses/<%= l._id %>/reset" method="POST" style="display:inline;">
                                                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                                <button type="submit" title="Reset HWID" class="action-button">
                                                    <i class="fas fa-rotate-right"></i>
                                                </button>
                                            </form>
                                            <form action="/staff/licenses/<%= l._id %>/extend" method="POST" style="display:inline;">
                                                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                                <input type="hidden" name="days" value="30">
                                                <button type="submit" title="Extend 30 days" class="action-button">
                                                    <i class="fas fa-calendar-plus"></i>
                                                </button>
                                            </form>
                                            <form action="/staff/licenses/<%= l._id %>/delete" method="POST" style="display:inline;" onsubmit="return confirm('Delete this license?');">
                                                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                                <button type="submit" title="Delete" class="action-button action-delete">
                                                    <i class="fas fa-trash"></i>
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            <% }); %>
                        </tbody>
                    </table>
                <% } %>
            </section>
        </div>
    </div>

    <%- include('../partials/footer') %>
</body>

</html>
