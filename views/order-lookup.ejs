<!DOCTYPE html>
<html lang="en" data-theme="dark">
<head>
<%- include('partials/credas-head', { pageTitle: 'Find your order', pageDesc: 'Look up an order with your reference and email address.' }) %>
</head>
<body>
<%- include('partials/navbar', { user, existingUser, currentPath: '/orders/lookup' }) %>

<main id="main">
<section class="page-head">
  <div class="wrap">
    <p class="crumb"><a href="/">Home</a><span>/</span>Order lookup</p>
    <h1 class="t-h1">Find your order</h1>
    <p class="t-lead" style="margin-top:var(--sp-3)">Enter the order reference from your confirmation email and the email address you used at checkout.</p>
  </div>
</section>

<section style="padding-bottom:var(--sp-8)">
  <div class="wrap" style="max-width:820px">

    <div class="px-glass" style="padding:clamp(20px,3vw,32px);margin-bottom:var(--sp-5)">
      <form method="POST" action="/orders/lookup">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <div class="grid-2">
          <div class="field" style="margin:0">
            <label for="ref">Order reference</label>
            <input class="input" id="ref" name="reference" required placeholder="ORD-XXXXXXXXXX" value="<%= reference || '' %>" autocomplete="off" style="font-family:var(--figure);text-transform:uppercase">
          </div>
          <div class="field" style="margin:0">
            <label for="em">Email used at checkout</label>
            <input class="input" id="em" name="email" type="email" required placeholder="you@example.com" autocomplete="email">
          </div>
        </div>
        <% if (error) { %>
          <p class="note note-danger" style="margin-top:var(--sp-4)"><%= error %></p>
        <% } %>
        <button class="btn btn-primary" type="submit" style="margin-top:var(--sp-4)">Find order</button>
      </form>
    </div>

    <% if (result) { %>
      <div class="px-glass" style="padding:clamp(20px,3vw,32px)">
        <div style="display:flex;align-items:center;gap:var(--sp-3);flex-wrap:wrap;margin-bottom:var(--sp-4)">
          <h2 class="t-h2" style="margin:0">Order <%= result.publicId %></h2>
          <span class="pill <%= result.status === 'paid' ? 'pill-active' : (result.status === 'refunded' ? 'pill-bad' : 'pill-warn') %>"><%= result.status %></span>
        </div>

        <dl class="kv" style="margin-bottom:var(--sp-5)">
          <dt>Placed</dt><dd><%= new Date(result.createdAt).toUTCString() %></dd>
          <dt>Payment</dt><dd><%= result.paymentMethod %></dd>
          <dt>Transaction</dt><dd><%= result.transactionID %></dd>
          <dt>Email</dt><dd><%= result.email %></dd>
          <dt>Total paid</dt><dd><%= result.totalPaid.toFixed(2) %></dd>
          <% if (result.refundedAmount > 0) { %><dt>Refunded</dt><dd><%= result.refundedAmount.toFixed(2) %></dd><% } %>
        </dl>

        <h3 class="t-h3" style="margin-bottom:var(--sp-2)">Items</h3>
        <div class="table-wrap" style="margin-bottom:var(--sp-5)">
          <table class="dtable">
            <thead><tr><th>Product</th><th class="num">Price</th></tr></thead>
            <tbody>
              <% (result.products || []).forEach(function (p) { %>
              <tr><td><b><%= p.name %></b></td><td class="num"><%= Number(p.salePrice != null && p.salePrice < p.price ? p.salePrice : p.price).toFixed(2) %></td></tr>
              <% }); %>
            </tbody>
          </table>
        </div>

        <div style="display:flex;gap:var(--sp-2);flex-wrap:wrap">
          <a class="btn btn-primary" href="/downloads">Go to downloads</a>
          <% if (result.status === 'paid') { %>
            <a class="btn btn-ghost" href="<%= typeof discordUrl !== 'undefined' ? discordUrl : '#' %>" onclick="return false">Reprint invoice</a>
          <% } %>
        </div>
        <p class="t-sm" style="margin-top:var(--sp-3)">Need help with this order? <a href="<%= settings.discordInviteLink %>" style="color:var(--accent)">Open a ticket</a> and include the reference above.</p>
      </div>
    <% } else { %>
      <div class="t-sm" style="text-align:center">
        Every order reference is also in your payment confirmation email and in your profile.
      </div>
    <% } %>
  </div>
</section>
</main>

<%- include('partials/footer') %>
</body>
</html>
