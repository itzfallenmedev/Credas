<!DOCTYPE html>
<html lang="en">
<head>
<%- include('partials/credas-head', { pageTitle: 'Page not found', pageDesc: errorMessage }) %>
</head>
<body>
<%- include('partials/navbar', { user: typeof user !== 'undefined' ? user : null, existingUser: typeof existingUser !== 'undefined' ? existingUser : null, currentPath: '' }) %>

<main id="main">
<section style="padding-block:var(--sp-9)">
  <div class="wrap">
    <div class="state" style="max-width:640px;margin-inline:auto">
      <i data-lucide="compass"></i>
      <h2>We could not find that page</h2>
      <p><%= errorMessage %></p>
      <div style="display:flex;gap:var(--sp-2);justify-content:center;flex-wrap:wrap;margin-top:var(--sp-5)">
        <a class="btn btn-primary" href="/">Back home</a>
        <a class="btn btn-ghost" href="/products">Browse all products</a>
      </div>
    </div>
  </div>
</section>
</main>

<%- include('partials/footer') %>
</body>
</html>
