<% var _p = typeof currentPath !== 'undefined' ? currentPath : ''; %>
<a class="skip" href="#main">Skip to products</a>

<% if (settings.announcementEnabled && settings.announcementText && settings.announcementText.trim()) { %>
<div class="notice">
  <div class="notice-in">
    <span><% if (settings.announcementLink) { %><a href="<%= settings.announcementLink %>"><%= settings.announcementText %></a><% } else { %><%= settings.announcementText %><% } %></span>
    <button class="x" type="button" data-notice-dismiss aria-label="Dismiss announcement"><i data-lucide="x"></i></button>
  </div>
</div>
<% } %>

<nav class="nav" aria-label="Primary">
  <div class="nav-in">
    <a class="brand" href="/">
      <%- include('brand-mark', { markAlt: '' }) %>
      <span>
        <span class="brand-name"><%= settings.storeName %></span>
        <% if (settings.tagline) { %><span class="brand-sub"><%= settings.tagline %></span><% } %>
      </span>
    </a>

    <form class="nav-search" role="search" onsubmit="return false">
      <label class="sr-only" for="nav-q">Search products</label>
      <i data-lucide="search"></i>
      <input class="input" id="nav-q" type="search" data-header-search placeholder="Search products" autocomplete="off">
    </form>

    <div class="nav-links">
      <a class="nav-link" href="/products" <%= _p.indexOf('/products') === 0 ? 'aria-current="page"' : '' %>>Products</a>
      <a class="nav-link" href="/reviews" <%= _p.indexOf('/reviews') === 0 ? 'aria-current="page"' : '' %>>Reviews</a>
      <% (settings.customNavTabs || []).forEach(function (t) { %>
        <a class="nav-link" href="<%= t.link %>" target="_blank" rel="noopener noreferrer"><%= t.name %><i data-lucide="external-link" style="width:12px;height:12px"></i></a>
      <% }); %>
    </div>

    <div class="nav-act">
      <% if (user) { %>
        <a class="icon-btn" href="/cart" aria-label="Cart">
          <i data-lucide="shopping-bag"></i>
          <span class="cart-count" data-cart data-empty="1" aria-live="polite"><%= (typeof existingUser !== 'undefined' && existingUser && existingUser.cart) ? existingUser.cart.length : 0 %></span>
        </a>
        <div class="menu" data-menu>
          <button class="user-btn" type="button" data-menu-btn aria-expanded="false" aria-haspopup="true">
            <% if (user.avatar) { %>
              <img src="https://cdn.discordapp.com/avatars/<%= user.id %>/<%= user.avatar %>.webp?size=64" alt="">
            <% } else { %>
              <span style="width:30px;height:30px;border-radius:50%;display:grid;place-items:center;background:var(--surface-2)"><i data-lucide="user" style="width:15px;height:15px"></i></span>
            <% } %>
            <span class="user-name"><%= user.username %></span>
            <i data-lucide="chevron-down" style="width:14px;height:14px;color:var(--muted)"></i>
          </button>
          <div class="menu-pop">
            <a class="menu-item" href="/profile/<%= user.id %>"><i data-lucide="user"></i>Your profile</a>
            <a class="menu-item" href="/cart"><i data-lucide="shopping-bag"></i>Cart</a>
            <% if (typeof isStaff !== 'undefined' && isStaff) { %><a class="menu-item" href="/staff/overview"><i data-lucide="settings"></i>Staff panel</a><% } %>
            <a class="menu-item" href="/logout"><i data-lucide="log-out"></i>Sign out</a>
          </div>
        </div>
      <% } else { %>
        <a class="btn btn-ghost btn-sm" href="/login"><i data-lucide="log-in"></i>Sign in</a>
      <% } %>
      <button class="icon-btn burger" type="button" data-burger aria-expanded="false" aria-label="Open menu"><i data-lucide="menu"></i></button>
    </div>
  </div>
</nav>

<div class="drawer" data-drawer data-open="false">
  <div class="drawer-panel" role="dialog" aria-modal="true" aria-label="Menu">
    <div class="drawer-head">
      <span class="brand-name"><%= settings.storeName %></span>
      <button class="icon-btn" type="button" data-drawer-close aria-label="Close menu"><i data-lucide="x"></i></button>
    </div>
    <form class="nav-search" role="search" style="max-width:none;margin-bottom:var(--sp-4)" onsubmit="return false">
      <label class="sr-only" for="drawer-q">Search products</label>
      <i data-lucide="search"></i>
      <input class="input" id="drawer-q" type="search" data-header-search placeholder="Search products">
    </form>
    <div class="drawer-links">
      <a href="/products">All products<i data-lucide="package"></i></a>
      <a href="/reviews">Reviews<i data-lucide="star"></i></a>
      <% (settings.customNavTabs || []).forEach(function (t) { %>
        <a href="<%= t.link %>" target="_blank" rel="noopener noreferrer"><%= t.name %><i data-lucide="external-link"></i></a>
      <% }); %>
      <div class="drawer-sep"></div>
      <% if (user) { %>
        <a href="/cart">Cart<i data-lucide="shopping-bag"></i></a>
        <a href="/profile/<%= user.id %>">Your profile<i data-lucide="user"></i></a>
        <% if (typeof isStaff !== 'undefined' && isStaff) { %><a href="/staff/overview">Staff panel<i data-lucide="settings"></i></a><% } %>
        <a href="/logout">Sign out<i data-lucide="log-out"></i></a>
      <% } else { %>
        <a href="/login">Sign in<i data-lucide="log-in"></i></a>
      <% } %>
    </div>
  </div>
</div>
