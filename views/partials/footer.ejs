<footer class="footer">
  <div class="wrap">
    <div class="footer-grid">
      <div>
        <a class="brand" href="/">
          <%- include('brand-mark', { markAlt: '' }) %>
          <span class="brand-name"><%= settings.storeName %></span>
        </a>
        <p style="margin-top:var(--sp-3)"><%= settings.footerDescription %></p>
        <div class="socials">
          <% if (settings.socialLinks && settings.socialLinks.length) { %>
            <% settings.socialLinks.forEach(function (s) { %>
              <a href="<%= s.url %>" target="_blank" rel="noopener noreferrer" title="<%= s.label %>"><i data-fa="<%= s.icon || 'fas fa-link' %>"></i></a>
            <% }); %>
          <% } else { %>
            <a href="<%= settings.discordInviteLink %>" target="_blank" rel="noopener noreferrer" title="Discord"><i data-lucide="message-circle"></i></a>
          <% } %>
        </div>
      </div>

      <div>
        <h2>Shop</h2>
        <div class="footer-links">
          <a href="/products">All products</a>
          <a href="/reviews">Customer reviews</a>
          <a href="/cart">Cart</a>
          <% (settings.customFooterTabs || []).forEach(function (t) { %><a href="<%= t.link %>"><%= t.name %></a><% }); %>
        </div>
      </div>

      <div>
        <h2>Support</h2>
        <div class="footer-links">
          <a href="<%= settings.discordInviteLink %>">Discord server</a>
          <a href="/tickets">Support tickets</a>
          <a href="/orders/lookup">Find my order</a>
          <a href="/status">Service status</a>
          <a href="/tos">Terms of service</a>
          <a href="/privacy-policy">Privacy policy</a>
        </div>
      </div>

      <div>
        <h2>New products</h2>
        <p><%= settings.newsletterText || 'One email when a product is added.' %></p>
        <form data-newsletter style="display:grid;gap:var(--sp-2);margin-top:var(--sp-3)">
          <label class="sr-only" for="nl-email">Email address</label>
          <input class="input" id="nl-email" name="email" type="email" autocomplete="email" required placeholder="you@example.com">
          <button class="btn btn-primary" type="submit">Subscribe</button>
        </form>
        <p class="t-sm" data-newsletter-done hidden>Subscribed. You will get an email when a product is added.</p>
      </div>
    </div>

    <div class="footer-bar">
      <span>© <span data-year></span> <%= settings.storeName %>. All rights reserved.</span>
      <% if (typeof locales !== 'undefined' && locales && locales.length) { %>
      <span class="langbar" style="margin-left:var(--sp-4)">
        <% locales.forEach(function (l) { %>
          <a href="/lang/<%= l.code %>" <%= (typeof locale !== 'undefined' && locale === l.code) ? 'aria-current="true"' : '' %>><%= l.native %></a>
        <% }); %>
      </span>
      <% } %>
      <% if (settings.showPaymentBadges) { %>
        <span class="pays">
          <% if (config && config.Payments && config.Payments.PayPal && config.Payments.PayPal.Enabled) { %><img src="/images/paypal.png" alt="PayPal"><% } %>
          <% if (config && config.Payments && config.Payments.Stripe && config.Payments.Stripe.Enabled) { %><img src="/images/card.png" alt="Card"><img src="/images/visa.png" alt="Visa"><% } %>
          <% if (config && config.Payments && config.Payments.Coinbase && config.Payments.Coinbase.Enabled) { %><img src="/images/coinbase.png" alt="Coinbase"><% } %>
        </span>
      <% } %>
    </div>
  </div>
</footer>

<script src="/js/credas.js?v=<%= (typeof assetVersion !== 'undefined' ? assetVersion : '1') %>" defer></script>
<script>
  document.querySelectorAll('[data-year]').forEach(function (el) { el.textContent = new Date().getFullYear(); });

  document.addEventListener('DOMContentLoaded', function () {
    var notice = document.querySelector('.notice');
    if (notice && sessionStorage.getItem('credas.notice') === '1') notice.remove();
    var x = document.querySelector('[data-notice-dismiss]');
    if (x) x.addEventListener('click', function () { notice.remove(); sessionStorage.setItem('credas.notice', '1'); });

    document.querySelectorAll('[data-newsletter]').forEach(function (form) {
      form.addEventListener('submit', function (e) {
        e.preventDefault();
        var email = form.email.value;
        var done = document.querySelector('[data-newsletter-done]');
        fetch('/newsletter', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ email: email }) })
          .then(function () { form.hidden = true; if (done) done.hidden = false; if (window.credasToast) window.credasToast('Subscribed to product updates'); })
          .catch(function () { if (done) done.hidden = false; });
      });
    });
  });
</script>
<% if (settings.customJS && settings.customJS.trim()) { %><script><%= settings.customJS %></script><% } %>
