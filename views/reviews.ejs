<!DOCTYPE html>
<html lang="en">
<head>
<%- include('partials/credas-head', { pageTitle: settings.reviewsPageTitle, pageDesc: settings.reviewsPageSubtitle }) %>
</head>
<body>
<%- include('partials/navbar', { user, existingUser, currentPath: '/reviews' }) %>
<% var dist = [0, 0, 0, 0, 0]; (reviews || []).forEach(function (r) { if (r.rating >= 1 && r.rating <= 5) dist[r.rating - 1]++; }); %>
<% var maxDist = Math.max.apply(null, dist.concat([1])); %>

<main id="main">
<section class="page-head">
  <div class="wrap">
    <p class="crumb"><a href="/">Home</a><span>/</span>Reviews</p>
    <h1 class="t-h1"><%= settings.reviewsPageTitle %></h1>
    <p class="t-lead" style="margin-top:var(--sp-3)"><%= settings.reviewsPageSubtitle %></p>
  </div>
</section>

<section style="padding-bottom:var(--sp-8)">
  <div class="wrap">

    <div class="rating-summary" style="margin-bottom:var(--sp-5)">
      <div>
        <div class="rating-big t-fig"><%= stats.averageRating %></div>
        <div class="stars" style="margin-top:6px" role="img" aria-label="Average <%= stats.averageRating %> out of 5">
          <% for (var i = 1; i <= 5; i++) { %><i data-lucide="star" class="<%= i <= Math.round(stats.averageRating) ? '' : 'off' %>"></i><% } %>
        </div>
        <div class="t-sm" style="margin-top:6px"><%= stats.totalReviews %> review<%= stats.totalReviews === 1 ? '' : 's' %></div>
      </div>
      <div class="bars">
        <% for (var d = 5; d >= 1; d--) { %>
        <div class="bar-row">
          <span><%= d %> star<%= d === 1 ? '' : 's' %></span>
          <span class="bar"><i data-bar="<%= dist[d - 1] / maxDist %>"></i></span>
          <span class="t-fig"><%= dist[d - 1] %></span>
        </div>
        <% } %>
      </div>
      <% if (user && products && products.length) { %>
        <div><button class="btn btn-primary btn-block" type="button" data-review-open>Write a review</button></div>
      <% } %>
    </div>

    <% if (user && products && !products.length) { %>
      <p class="t-sm" style="margin-bottom:var(--sp-4)">You have no products available to review. Buy something, or pick up a free product, then you can leave a review.</p>
    <% } %>

    <% if (!reviews || !reviews.length) { %>
      <div class="state">
        <i data-lucide="message-square"></i>
        <h2>No reviews yet</h2>
        <p>Nobody has reviewed a product yet. The first review posted appears here and on the product page.</p>
      </div>
    <% } else { %>
      <div class="review-grid">
        <% reviews.forEach(function (r) { %>
        <article class="review">
          <div class="stars" role="img" aria-label="<%= r.rating %> out of 5">
            <% for (var s = 1; s <= 5; s++) { %><i data-lucide="star" class="<%= s <= r.rating ? '' : 'off' %>"></i><% } %>
          </div>
          <blockquote><%= r.comment %></blockquote>
          <div class="review-who">
            <img src="<%= r.discordAvatar %>" alt="" loading="lazy" onerror="this.src='/images/default-avatar.png'">
            <div style="min-width:0">
              <b><%= r.discordUsername %></b>
              <span><%= r.productName || 'Verified buyer' %><%= r.createdAt ? ' · ' + new Date(r.createdAt).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' }) : '' %></span>
            </div>
          </div>
          <% if (user && (isStaff || (settings.allowReviewDeletion && user.id === r.discordID))) { %>
          <form action="/reviews/<%= r._id %>/delete" method="POST" style="margin-top:var(--sp-3)">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <button class="btn btn-quiet btn-sm" type="submit" onclick="return confirm('Delete this review?')">Delete review</button>
          </form>
          <% } %>
        </article>
        <% }); %>
      </div>

      <% if (totalPages > 1) { %>
      <nav class="chips" style="margin-top:var(--sp-6);justify-content:center" aria-label="Review pages">
        <% if (currentPage > 1) { %><a class="chip" href="/reviews?page=<%= currentPage - 1 %>">Previous</a><% } %>
        <% for (var p = 1; p <= totalPages; p++) { %>
          <a class="chip" href="/reviews?page=<%= p %>" <%= p === currentPage ? 'aria-current="page"' : '' %>><%= p %></a>
        <% } %>
        <% if (currentPage < totalPages) { %><a class="chip" href="/reviews?page=<%= currentPage + 1 %>">Next</a><% } %>
      </nav>
      <% } %>
    <% } %>
  </div>
</section>
</main>

<div class="dialog-wrap" id="review-dialog" data-open="false">
  <div class="dialog" style="max-width:540px" role="dialog" aria-modal="true" aria-labelledby="rv-t">
    <div class="dialog-head">
      <h2 id="rv-t">Write a review</h2>
      <button class="dialog-x" type="button" data-dialog-close aria-label="Close"><i data-lucide="x"></i></button>
    </div>
    <div class="dialog-body">
      <form action="/reviews" method="POST">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <div class="field">
          <label for="rv-p">Product</label>
          <select class="select" id="rv-p" name="productId" required data-autofocus>
            <% (products || []).forEach(function (p) { %><option value="<%= p._id %>"><%= p.name || 'Unnamed product' %></option><% }); %>
          </select>
        </div>
        <div class="field">
          <label for="rv-r">Rating</label>
          <select class="select" id="rv-r" name="rating" required>
            <option value="5">5 out of 5</option><option value="4">4 out of 5</option>
            <option value="3">3 out of 5</option><option value="2">2 out of 5</option><option value="1">1 out of 5</option>
          </select>
        </div>
        <div class="field">
          <label for="rv-c">Your review</label>
          <textarea class="textarea" id="rv-c" name="comment" required minlength="<%= settings.minimumReviewLength %>" maxlength="350" rows="4" placeholder="What did you use it for? Specific answers help other buyers most."></textarea>
          <span class="hint"><span data-chars>350</span> characters remaining, <%= settings.minimumReviewLength %> minimum.</span>
        </div>
        <button class="btn btn-primary btn-block" type="submit">Post review</button>
      </form>
    </div>
  </div>
</div>

<%- include('partials/footer') %>
<script>
  document.addEventListener('DOMContentLoaded', function () {
    var open = document.querySelector('[data-review-open]');
    if (open) open.setAttribute('data-dialog-open', 'review-dialog');
    var ta = document.getElementById('rv-c');
    var cc = document.querySelector('[data-chars]');
    if (ta && cc) ta.addEventListener('input', function () { cc.textContent = String(350 - ta.value.length); });
  });
</script>
</body>
</html>
