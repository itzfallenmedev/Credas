<!DOCTYPE html>
<html lang="en">
<head>
<%- include('partials/credas-head', { pageTitle: 'Your cart', pageDesc: 'Review your items and pay.' }) %>
</head>
<body>
<%- include('partials/navbar', { user, existingUser, currentPath: '/cart' }) %>

<main id="main">
<section class="page-head">
  <div class="wrap">
    <p class="crumb"><a href="/">Home</a><span>/</span>Cart</p>
    <h1 class="t-h1">Your cart</h1>
    <p class="t-sm" style="margin-top:var(--sp-2)"><%= cartProducts.length %> item<%= cartProducts.length === 1 ? '' : 's' %>. Every price includes future updates.</p>
  </div>
</section>

<section style="padding-bottom:var(--sp-8)">
  <div class="wrap">
    <% if (!cartProducts || !cartProducts.length) { %>
      <div class="state">
        <i data-lucide="shopping-bag"></i>
        <h2>Your cart is empty</h2>
        <p>Nothing has been added yet. Browse the shelf and add a product to continue.</p>
        <a class="btn btn-primary" href="/products">Browse all products</a>
      </div>
    <% } else { %>
      <div class="cart-grid">
        <div class="cart-panel">
          <% cartProducts.forEach(function (p) { %>
          <% var now = new Date(); var sale = p.onSale && p.saleStartDate && p.saleEndDate && new Date(p.saleStartDate) <= now && now <= new Date(p.saleEndDate); %>
          <div class="cart-row">
            <a href="/products/<%= p.urlId %>"><img src="/<%= p.bannerImage %>" alt="" loading="lazy"></a>
            <div style="min-width:0">
              <a class="cart-title" href="/products/<%= p.urlId %>"><%= p.name %></a>
              <div class="cart-price"><%= settings.currencySymbol %><%= Number(p.effectivePrice != null ? p.effectivePrice : (sale ? p.salePrice : p.price)).toFixed(2) %></div>
              <% if (sale) { %><s class="t-sm"><%= settings.currencySymbol %><%= p.price.toFixed(2) %></s><% } %>
            </div>
            <form action="/cart/remove/<%= p._id %>" method="POST">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <button class="icon-btn" type="submit" aria-label="Remove <%= p.name %>"><i data-lucide="trash-2"></i></button>
            </form>
          </div>
          <% }); %>
          <a class="btn btn-quiet btn-sm" href="/products" style="margin-top:var(--sp-4)">Keep browsing</a>
        </div>

        <aside class="cart-panel summary">
          <h2 class="t-h3" style="margin-bottom:var(--sp-3)">Order summary</h2>

          <% if (discountApplied) { %>
            <div class="sum-row"><span>Discount (<%= discountPercentage %>%)</span><span class="t-fig" style="color:var(--success)">−<%= settings.currencySymbol %><%= discountAmount.toFixed(2) %></span></div>
          <% } %>
          <% if (typeof salesTaxAmount !== 'undefined' && salesTaxAmount > 0) { %>
            <div class="sum-row"><span>Sales tax</span><span class="t-fig"><%= settings.currencySymbol %><%= salesTaxAmount.toFixed(2) %></span></div>
          <% } %>

          <div class="sum-row" style="border-top:1px solid var(--line);margin-top:var(--sp-2);padding-top:var(--sp-3)">
            <span style="font-weight:600;color:var(--ink)">Total</span>
            <span class="sum-total"><%= settings.currencySymbol %><%= totalPrice.toFixed(2) %></span>
          </div>
          <% if (discountApplied) { %><p class="t-sm">Was <s><%= settings.currencySymbol %><%= originalTotal.toFixed(2) %></s> before the discount.</p><% } %>

          <form action="/checkout/apply-discount" method="POST" style="margin-top:var(--sp-4)">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <div class="field" style="margin:0">
              <label for="code">Discount code</label>
              <div style="display:flex;gap:var(--sp-2)">
                <input class="input" id="code" name="discountCode" type="text" placeholder="Enter code" autocomplete="off">
                <button class="btn btn-ghost" type="submit">Apply</button>
              </div>
              <% if (discountError) { %><span class="err"><%= discountError %></span><% } %>
            </div>
          </form>

          <label class="check" style="margin-top:var(--sp-4)">
            <input type="checkbox" id="terms">
            <span>I accept the <a href="/tos" target="_blank" style="color:var(--accent)">terms of service</a>.</span>
          </label>

          <div style="display:grid;gap:var(--sp-2);margin-top:var(--sp-4)">
            <% if (config.Payments.PayPal.Enabled) { %>
              <form action="/checkout/paypal" method="POST"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn paypal btn-block" type="submit" data-pay disabled>Pay with PayPal</button></form>
            <% } %>
            <% if (config.Payments.Stripe.Enabled) { %>
              <form action="/checkout/stripe" method="POST"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn stripe btn-block" type="submit" data-pay disabled>Pay with card</button></form>
            <% } %>
            <% if (config.Payments.Coinbase.Enabled) { %>
              <form action="/checkout/coinbase" method="POST"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn crypto btn-block" type="submit" data-pay disabled>Pay with crypto</button></form>
            <% } %>
          </div>

          <div class="trust" style="flex-direction:column;gap:8px;border:0;padding:var(--sp-4) 0 0">
            <span class="trust-item"><i data-lucide="lock"></i>Encrypted checkout</span>
            <span class="trust-item"><i data-lucide="receipt"></i>Invoice emailed on payment</span>
          </div>
        </aside>
      </div>
    <% } %>
  </div>
</section>
</main>

<%- include('partials/footer') %>
<script>
  document.addEventListener('DOMContentLoaded', function () {
    var terms = document.getElementById('terms');
    if (!terms) return;
    var pays = Array.prototype.slice.call(document.querySelectorAll('[data-pay]'));
    terms.addEventListener('change', function () { pays.forEach(function (b) { b.disabled = !terms.checked; }); });
  });
</script>
</body>
</html>
