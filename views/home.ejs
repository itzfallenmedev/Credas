<!DOCTYPE html>
<html lang="en">
<head>
<%- include('partials/credas-head', { pageTitle: null, pageDesc: null }) %>
</head>
<body>
<%- include('partials/navbar', { user, existingUser, currentPath: '/' }) %>

<main id="main">

<!-- ══ HERO ══ -->
<section class="px-hero">
  <% if (settings.backgroundImagePath && !settings.backgroundGradient) { %>
    <div class="px-hero-img" style="background-image:url('<%= settings.backgroundImagePath %>')"></div>
  <% } %>
  <div class="px-grid" aria-hidden="true"></div>
  <div aria-hidden="true">
    <span class="px-mote"></span><span class="px-mote"></span><span class="px-mote"></span><span class="px-mote"></span>
    <span class="px-mote"></span><span class="px-mote"></span><span class="px-mote"></span><span class="px-mote"></span>
  </div>

  <div class="wrap px-hero-in" data-stagger>
    <div class="px-logo enter">
      <%- include('partials/brand-mark', { markClass: 'is-lg', markAlt: settings.storeName }) %>
    </div>

    <h1 class="px-title enter"><%= settings.homePageTitle %></h1>
    <div class="px-divider enter"><i></i><i></i></div>
    <p class="px-sub enter"><%= settings.homePageSubtitle %></p>

    <div class="px-cta enter">
      <a class="px-btn px-btn-primary" href="/products">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/><path d="M3 6h18"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>
        Browse Products
      </a>
      <a class="px-btn px-btn-glass" href="<%= settings.discordInviteLink %>">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20.317 4.369a19.79 19.79 0 0 0-4.885-1.515.074.074 0 0 0-.079.037c-.21.375-.444.864-.608 1.249a18.27 18.27 0 0 0-5.487 0 12.64 12.64 0 0 0-.617-1.25.077.077 0 0 0-.079-.036A19.736 19.736 0 0 0 3.677 4.37a.07.07 0 0 0-.032.027C.533 9.046-.32 13.58.099 18.057a.082.082 0 0 0 .031.056 19.9 19.9 0 0 0 5.993 3.03.078.078 0 0 0 .084-.028 14.09 14.09 0 0 0 1.226-1.994.076.076 0 0 0-.041-.106 13.107 13.107 0 0 1-1.872-.892.077.077 0 0 1-.007-.128c.126-.094.252-.192.372-.291a.074.074 0 0 1 .077-.01c3.928 1.793 8.18 1.793 12.062 0a.074.074 0 0 1 .078.009c.12.099.246.198.373.292a.077.077 0 0 1-.006.127 12.3 12.3 0 0 1-1.873.891.077.077 0 0 0-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 0 0 .084.028 19.839 19.839 0 0 0 6.002-3.03.077.077 0 0 0 .032-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 0 0-.031-.03zM8.02 15.331c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.955-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.956 2.418-2.157 2.418zm7.975 0c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.955-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.946 2.418-2.157 2.418z"/></svg>
        Join Discord
      </a>
    </div>

    <div class="px-rating enter">
      <span class="stars" role="img" aria-label="Average rating">
        <% for (var s = 1; s <= 5; s++) { %><i data-lucide="star" style="width:12px;height:12px;fill:currentColor;color:#fbbf24"></i><% } %>
      </span>
      <b><%= (stats && stats.averageRating) ? Number(stats.averageRating).toFixed(1) : '5.0' %></b>
    </div>
  </div>

  <a class="px-cue" href="#shelf" aria-label="Scroll to products"><i data-lucide="chevron-down"></i></a>
</section>

<!-- ══ FEATURES ══ -->
<% if (settings.displayFeatures && settings.features && settings.features.length) { %>
<section class="px-band px-band-alt" id="features">
  <div class="px-blob b1" aria-hidden="true"></div>
  <div class="px-blob b2" aria-hidden="true"></div>
  <div class="wrap">
    <div class="px-head">
      <span class="px-chip"><span class="dot"></span>Features</span>
      <h2 class="t-display">Why Choose <span style="color:var(--accent)"><%= settings.storeName %></span>?</h2>
      <p>What every order includes, and how you get your files.</p>
    </div>
    <div class="px-cols">
      <% settings.features.slice(0, 3).forEach(function (f, i) { %>
      <article class="px-glass px-feature">
        <span class="px-glass-bar"></span>
        <div class="px-icon">
          <span class="px-icon-ring"></span>
          <i data-fa="<%= f.icon %>"></i>
        </div>
        <h3><%= f.title %></h3>
        <p><%= f.description %></p>
      </article>
      <% }); %>
    </div>
  </div>
</section>
<% } %>

<!-- ══ PRODUCT SHELF PREVIEW ══ -->
<section class="px-band" id="shelf">
  <div class="wrap">
    <div class="px-head">
      <span class="px-chip"><span class="dot"></span>Catalogue</span>
      <h2 class="t-display">Browse the <span style="color:var(--accent)">shelf</span></h2>
      <p><%= settings.productsPageSubtitle %></p>
    </div>
    <% if (typeof featuredProducts !== 'undefined' && featuredProducts && featuredProducts.length) { %>
      <div class="plates">
        <% featuredProducts.forEach(function (p) { %>
        <% var now = new Date(); %>
        <% var sale = p.onSale && p.saleStartDate && p.saleEndDate && new Date(p.saleStartDate) <= now && now <= new Date(p.saleEndDate); %>
        <% var eff = sale ? p.salePrice : p.price; %>
        <% var oos = p.productType === 'serials' && (!p.serials || !p.serials.length); %>
        <article class="plate-card">
          <div class="plate-media">
            <a href="/products/<%= p.urlId %>" tabindex="-1" aria-hidden="true"><img src="/<%= p.bannerImage %>" alt="" loading="lazy"></a>
            <div class="plate-flags">
              <% if (sale) { %><span class="flag flag-sale">Sale</span><% } %>
              <% if (p.productType === 'digitalFree') { %><span class="flag flag-free">Free</span><% } %>
            </div>
          </div>
          <div class="plate-body">
            <% if (p.category) { %><span class="plate-cat"><%= p.category %></span><% } %>
            <h3><a href="/products/<%= p.urlId %>"><%= p.name %></a></h3>
            <% if (oos) { %><span class="stock-line out"><span class="dot"></span>Out of stock</span><% } %>
          </div>
          <div class="plate-buy">
            <span class="price <%= sale ? 'is-sale' : '' %>"><% if (p.productType === 'digitalFree') { %>Free<% } else { %><%= settings.currencySymbol %><%= Number(eff).toFixed(2) %><% } %></span>
            <span class="spacer"></span>
            <% if (!p.pauseSelling && !oos && p.productType !== 'digitalFree') { %>
              <form action="/cart/add/<%= p._id %>" method="POST">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <button class="btn btn-primary btn-sm" type="submit">Add to cart</button>
              </form>
            <% } else { %>
              <a class="btn btn-ghost btn-sm" href="/products/<%= p.urlId %>">View</a>
            <% } %>
          </div>
        </article>
        <% }); %>
      </div>
      <div style="display:flex;justify-content:center;margin-top:var(--sp-6)">
        <a class="btn btn-primary btn-lg" href="/products">View all products</a>
      </div>
    <% } else { %>
      <div class="state">
        <i data-lucide="package-open"></i>
        <h2>Nothing listed yet</h2>
        <p>No products have been added to the shelf. Ask in the Discord when the next batch goes live.</p>
        <a class="btn btn-primary" href="<%= settings.discordInviteLink %>">Join the Discord</a>
      </div>
    <% } %>
  </div>
</section>

<!-- ══ IMPACT ══ -->
<% if (settings.displayStats && stats) { %>
<section class="px-band">
  <div class="wrap">
    <div class="px-head">
      <h2 class="t-display">Our <span style="color:var(--accent)">Impact</span></h2>
      <p>Numbers the server keeps, not numbers somebody typed in.</p>
    </div>
    <div class="px-cols px-cols-2" style="max-width:900px;margin-inline:auto">
      <div class="px-glass px-stat">
        <div class="px-icon"><i data-lucide="shopping-cart"></i></div>
        <b><%= (stats.totalPurchases || 0).toLocaleString('en-US') %>+</b>
        <span>Total Purchases</span>
      </div>
      <div class="px-glass px-stat">
        <div class="px-icon"><i data-lucide="package-open"></i></div>
        <b><%= totalProducts %>+</b>
        <span>Products Available</span>
      </div>
    </div>
  </div>
</section>
<% } %>

<!-- ══ REVIEWS ══ -->
<% if (settings.displayReviews && reviews && reviews.length) { %>
<section class="px-band px-band-alt">
  <div class="wrap">
    <div class="px-head">
      <span class="px-chip"><span class="dot"></span>Customer Reviews</span>
      <h2 class="t-display">What Our <span style="color:var(--accent)">Customers</span> Say</h2>
      <p>Over <span style="color:var(--accent);font-weight:600"><%= totalUsers.toLocaleString('en-US') %>+</span> people have an account here.</p>
    </div>
  </div>
  <% var _loop = reviews.concat(reviews); %>
  <div class="px-marquee">
    <div class="px-track">
      <% _loop.concat(_loop).forEach(function (r) { %>
      <article class="px-glass px-review">
        <div class="stars">
          <% for (var s = 0; s < r.rating; s++) { %><i data-lucide="star" style="fill:currentColor;color:#fbbf24"></i><% } %>
          <% for (var s2 = r.rating; s2 < 5; s2++) { %><i data-lucide="star" style="color:var(--line-2)"></i><% } %>
        </div>
        <p>“<%= r.comment %>”</p>
        <div class="review-who">
          <img src="<%= r.discordAvatar %>" alt="" loading="lazy" onerror="this.src='/images/default-avatar.png'">
          <div><b><%= r.discordUsername %></b><span>Verified Customer</span></div>
        </div>
      </article>
      <% }); %>
    </div>
  </div>
  <div class="wrap" style="display:flex;justify-content:center;margin-top:var(--sp-6)">
    <a class="btn btn-ghost" href="/reviews">Read all reviews</a>
  </div>
</section>
<% } %>

<!-- ══ ABOUT ══ -->
<% if (settings.aboutUsVisible && settings.aboutUsText && settings.aboutUsText.trim()) { %>
<section class="px-band">
  <div class="wrap">
    <div class="px-head">
      <h2 class="t-display">About <span style="color:var(--accent)">Us</span></h2>
      <p>Who runs the store and what it sells.</p>
    </div>
    <div class="px-glass" style="max-width:900px;margin-inline:auto;padding:clamp(24px,4vw,52px)">
      <div class="prose"><%- md.render(settings.aboutUsText) %></div>
    </div>
  </div>
</section>
<% } %>

<!-- ══ FAQ ══ -->
<% if (settings.displayFaq && settings.faqItems && settings.faqItems.length) { %>
<section class="px-band px-band-alt">
  <div class="px-blob b1" aria-hidden="true"></div>
  <div class="wrap" style="position:relative">
    <div class="px-head">
      <h2 class="t-display">Questions</h2>
      <p>Still stuck? Ask in the <a href="<%= settings.discordInviteLink %>" style="color:var(--accent)">Discord</a>.</p>
    </div>
    <div class="faq" style="margin-inline:auto;max-width:760px;background:rgba(26,26,26,0.72);border:1px solid var(--line);border-radius:var(--r-lg);padding:0 var(--sp-5)">
      <% settings.faqItems.forEach(function (f) { %>
      <div class="faq-item" data-open="false">
        <button class="faq-q" type="button" aria-expanded="false"><%= f.question %><i data-lucide="plus"></i></button>
        <div class="faq-a"><div><p><%= f.answer %></p></div></div>
      </div>
      <% }); %>
    </div>
  </div>
</section>
<% } %>

<!-- ══ CTA ══ -->
<% if (settings.displayCTABanner) { %>
<section class="px-band">
  <div class="px-blob b1" aria-hidden="true"></div>
  <div class="px-blob b2" aria-hidden="true"></div>
  <div class="wrap" style="position:relative;text-align:center;max-width:760px">
    <h2 class="t-display">Ready to Get <span style="color:var(--accent)">Started?</span></h2>
    <p class="px-sub" style="margin:18px auto 0">Pick a product, pay once, and download it the moment payment clears.</p>
    <div class="px-cta" style="margin-top:32px">
      <a class="px-btn px-btn-primary" href="/products">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/><path d="M3 6h18"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>
        Explore Products
      </a>
      <a class="px-btn px-btn-glass" href="<%= settings.discordInviteLink %>">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20.317 4.369a19.79 19.79 0 0 0-4.885-1.515.074.074 0 0 0-.079.037c-.21.375-.444.864-.608 1.249a18.27 18.27 0 0 0-5.487 0 12.64 12.64 0 0 0-.617-1.25.077.077 0 0 0-.079-.036A19.736 19.736 0 0 0 3.677 4.37a.07.07 0 0 0-.032.027C.533 9.046-.32 13.58.099 18.057a.082.082 0 0 0 .031.056 19.9 19.9 0 0 0 5.993 3.03.078.078 0 0 0 .084-.028 14.09 14.09 0 0 0 1.226-1.994.076.076 0 0 0-.041-.106 13.107 13.107 0 0 1-1.872-.892.077.077 0 0 1-.007-.128c.126-.094.252-.192.372-.291a.074.074 0 0 1 .077-.01c3.928 1.793 8.18 1.793 12.062 0a.074.074 0 0 1 .078.009c.12.099.246.198.373.292a.077.077 0 0 1-.006.127 12.3 12.3 0 0 1-1.873.891.077.077 0 0 0-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 0 0 .084.028 19.839 19.839 0 0 0 6.002-3.03.077.077 0 0 0 .032-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 0 0-.031-.03zM8.02 15.331c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.955-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.956 2.418-2.157 2.418zm7.975 0c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.955-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.946 2.418-2.157 2.418z"/></svg>
        Join Our Discord
      </a>
    </div>
  </div>
</section>
<% } %>

</main>

<%- include('partials/footer') %>
</body>
</html>
