<!DOCTYPE html>
<html lang="en">
<head>
<%- include('partials/credas-head', { pageTitle: product.name, pageDesc: String(product.description || '').replace(/[#*`>\[\]()!]/g, '').slice(0, 160) }) %>
</head>
<body>
<%- include('partials/navbar', { user, existingUser, currentPath: '/products' }) %>
<% var now = new Date(); %>
<% var sale = product.onSale && product.saleStartDate && product.saleEndDate && new Date(product.saleStartDate) <= now && now <= new Date(product.saleEndDate); %>
<% var eff = sale ? product.salePrice : product.price; %>
<% var off = sale && product.price ? Math.round(((product.price - product.salePrice) / product.price) * 100) : 0; %>
<% var owned = existingUser && existingUser.ownedProducts && existingUser.ownedProducts.some(function (x) { try { return x.equals(product._id); } catch (e) { return String(x) === String(product._id); } }); %>
<% var oos = product.productType === 'serials' && (!product.serials || !product.serials.length); %>
<% var canBuy = user && existingUser && !product.pauseSelling && !oos; %>

<main id="main" data-viewed='<%- JSON.stringify({ n: product.name, u: "/products/" + product.urlId, i: "/" + product.bannerImage }).replace(/'/g, "&#39;") %>'>

<div class="wrap" style="padding-top:var(--sp-4)">
  <p class="crumb"><a href="/">Home</a><span>/</span><a href="/products">Products</a><span>/</span><%= product.name %></p>
</div>

<section style="padding-bottom:var(--sp-8)">
  <div class="wrap">
    <div class="pdp">

      <div>
        <figure class="pdp-media" style="margin:0">
          <div class="media">
            <img src="/<%= product.bannerImage %>" alt="<%= product.name %>">
            <% if (sale) { %><span class="flag flag-sale" style="position:absolute;top:12px;left:12px">−<%= off %>% off</span><% } %>
          </div>
          <figcaption>
            <span>Product #<%= String(product.position || 0).padStart(3, '0') %></span>
            <span>Updated <%= product.versions && product.versions.length ? new Date(Math.max.apply(null, product.versions.map(function (v) { return new Date(v.releaseDate).getTime(); }))).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' }) : new Date(product.createdAt).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' }) %></span>
            <% if (settings.wishlistEnabled) { %>
              <button class="save-btn" style="position:static;margin-left:auto" type="button" data-save="<%= product._id %>" aria-pressed="false" aria-label="Save this product"><i data-lucide="heart"></i></button>
            <% } %>
          </figcaption>
        </figure>

        <div class="tabs" style="margin-top:var(--sp-6)">
          <h2 class="t-h3">Description</h2>
          <hr class="rule">
          <div class="prose">
            <% if (product.description && product.description.trim()) { %><%- md.render(product.description) %><% } else { %><p>No description has been written for this product yet.</p><% } %>
          </div>
        </div>

        <% if (product.dependencies && product.dependencies.trim()) { %>
        <div style="margin-top:var(--sp-6)">
          <h2 class="t-h3">Requirements</h2>
          <hr class="rule">
          <div class="prose"><%- md.render(product.dependencies) %></div>
        </div>
        <% } %>

        <% if (product.versions && product.versions.length) { %>
        <div style="margin-top:var(--sp-6)">
          <h2 class="t-h3">Changelog</h2>
          <hr class="rule">
          <div style="display:grid;gap:var(--sp-3)">
            <% product.versions.slice().sort(function (a, b) { return new Date(b.releaseDate) - new Date(a.releaseDate); }).forEach(function (v) { %>
            <div style="display:flex;gap:var(--sp-4);align-items:baseline;padding-bottom:var(--sp-3);border-bottom:1px solid var(--line)">
              <span class="t-fig" style="color:var(--accent);min-width:72px"><%= v.version %></span>
              <div style="flex:1">
                <p class="t-body"><%= v.changelog %></p>
                <p class="t-sm" style="margin-top:2px"><%= new Date(v.releaseDate).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' }) %> · <%= (v.downloadCount || 0).toLocaleString('en-US') %> downloads</p>
              </div>
            </div>
            <% }); %>
          </div>
        </div>
        <% } %>

        <% if (reviews && reviews.length && settings.displayProductReviews) { %>
        <div style="margin-top:var(--sp-7)">
          <h2 class="t-h3">Reviews for this product</h2>
          <hr class="rule">
          <div class="review-grid">
            <% reviews.slice(0, 4).forEach(function (r) { %>
            <article class="review">
              <div class="stars" role="img" aria-label="<%= r.rating %> out of 5">
                <% for (var s = 1; s <= 5; s++) { %><i data-lucide="star" class="<%= s <= r.rating ? '' : 'off' %>"></i><% } %>
              </div>
              <blockquote><%= r.comment %></blockquote>
              <div class="review-who">
                <img src="<%= r.discordAvatar %>" alt="" loading="lazy" onerror="this.src='/images/default-avatar.png'">
                <div><b><%= r.discordUsername %></b><span><%= new Date(r.createdAt).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' }) %></span></div>
              </div>
            </article>
            <% }); %>
          </div>
        </div>
        <% } %>
      </div>

      <div class="buy-box">
        <% if (product.category) { %><span class="plate-cat"><%= product.category %></span><% } %>
        <h1 class="t-h1" style="margin-top:var(--sp-2)"><%= product.name %></h1>

        <p class="buy-price <%= sale ? 'is-sale' : '' %>" style="margin-top:var(--sp-4)">
          <% if (product.productType === 'digitalFree') { %>Free<% } else { %><%= settings.currencySymbol %><%= Number(eff).toFixed(2) %><% if (sale) { %><s><%= settings.currencySymbol %><%= product.price.toFixed(2) %></s><% } %><% } %>
        </p>
        <% if (sale) { %><span class="countdown" data-countdown="<%= new Date(product.saleEndDate).toISOString() %>"></span><% } %>

        <% if (product.productType === 'serials') { %>
          <p style="margin-top:var(--sp-3)">
            <% if (oos) { %><span class="stock-line out"><span class="dot"></span>Out of stock</span>
            <% } else { %><span class="stock-line ok"><span class="dot"></span><%= product.serials.length %> keys in stock</span><% } %>
          </p>
        <% } %>
        <% if (product.pauseSelling) { %><p class="note" style="margin-top:var(--sp-3)">Sales are paused for this product right now.</p><% } %>
        <% if (oos) { %><p class="note note-danger" style="margin-top:var(--sp-3)">No keys left. Restocks are announced in the Discord first.</p><% } %>

        <div class="buy-act">
          <% if (owned && product.productType === 'service') { %>
            <a class="btn btn-primary btn-lg btn-block" href="/profile/<%= existingUser.discordID %>">Open your profile</a>
          <% } else if ((owned || product.productType === 'digitalFree') && (product.productType !== 'serials' || (product.productType === 'serials' && product.serialRequiresFile))) { %>
            <a class="btn btn-primary btn-lg btn-block" href="/downloads/<%= product.urlId %>"><i data-lucide="download"></i>Download files</a>
          <% } %>
          <% if (product.productType !== 'digitalFree') { %>
            <form action="/cart/add/<%= product._id %>" method="POST">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <button class="btn btn-<%= canBuy ? 'primary' : 'secondary' %> btn-lg btn-block" type="submit" <%= canBuy ? 'data-add' : 'disabled' %>>
                <i data-lucide="shopping-bag"></i><span data-add-label><%= canBuy ? 'Add to cart' : (oos ? 'Out of stock' : product.pauseSelling ? 'Sales paused' : 'Sign in to buy') %></span>
              </button>
            </form>
            <% if (!user) { %><a class="btn btn-ghost btn-block" href="/login">Sign in with Discord</a><% } %>
          <% } %>
        </div>

        <div class="trust" style="flex-direction:column;gap:10px;border:0;padding:var(--sp-4) 0 0">
          <span class="trust-item"><i data-lucide="zap"></i>Files unlock the moment payment clears</span>
          <span class="trust-item"><i data-lucide="refresh-cw"></i>Every future version included</span>
          <span class="trust-item"><i data-lucide="lock"></i>Payment handled by PayPal, Stripe or Coinbase</span>
        </div>

        <dl class="spec">
          <div><dt>Orders</dt><dd><%= (product.totalPurchases || 0).toLocaleString('en-US') %></dd></div>
          <div><dt>Downloads</dt><dd><%= (product.totalDownloads || 0).toLocaleString('en-US') %></dd></div>
          <div><dt>Type</dt><dd><%= product.productType === 'digitalFree' ? 'Free' : product.productType === 'digitalPaid' ? 'File' : product.productType === 'serials' ? 'Keys' : 'Service' %></dd></div>
          <div><dt>Versions</dt><dd><%= product.versions ? product.versions.length : 0 %></dd></div>
        </dl>

        <% if (typeof isStaff !== 'undefined' && isStaff) { %>
          <div style="display:flex;gap:var(--sp-2);flex-wrap:wrap;margin-top:var(--sp-5);padding-top:var(--sp-4);border-top:1px solid var(--line)">
            <a class="btn btn-ghost btn-sm" href="/staff/products/update/<%= product._id %>">Push update</a>
            <a class="btn btn-ghost btn-sm" href="/staff/products/edit/<%= product._id %>">Edit listing</a>
          </div>
        <% } %>
      </div>
    </div>

    <div data-recent-wrap style="margin-top:var(--sp-8)">
      <h2 class="t-h3" style="margin-bottom:var(--sp-4)">Recently viewed</h2>
      <div class="plates dense" data-recent></div>
    </div>
  </div>
</section>
</main>

<%- include('partials/footer') %>
<script>
  document.addEventListener('DOMContentLoaded', function () {
    try {
      var v = JSON.parse(document.getElementById('main').dataset.viewed);
      var list = JSON.parse(localStorage.getItem('credas.recent') || '[]').filter(function (x) { return x.u !== v.u; });
      list.unshift(v);
      localStorage.setItem('credas.recent', JSON.stringify(list.slice(0, 8)));
    } catch (e) {}
  });
</script>
</body>
</html>
